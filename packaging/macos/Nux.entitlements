<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime exceptions for the Developer ID signed Nux.app. The release workflow hands this file to
  jpackage as its mac-entitlements option when it signs; notarization requires the hardened runtime, and a
  JVM cannot run under it without these two:
    allow-jit                        HotSpot's JIT maps its code cache with MAP_JIT.
    allow-unsigned-executable-memory the JVM writes executable stubs and adapters outside MAP_JIT regions.
  Library validation stays ON: every native library Nux loads is the JDK's or JavaFX's, inside the
  bundle's runtime and signed with the same team ID as the app.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
