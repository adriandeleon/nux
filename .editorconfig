# EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
indent_style = space
indent_size = 4
max_line_length = 120

[*.xml]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.css]
indent_size = 4

[*.sh]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

# Markdown uses trailing spaces for hard line breaks.
[*.md]
trim_trailing_whitespace = false

# Generated by the Maven wrapper; left exactly as shipped.
[{mvnw,mvnw.cmd,.mvn/**}]
trim_trailing_whitespace = false
insert_final_newline = false

# Desktop entries are substituted verbatim by jpackage.
[*.desktop]
trim_trailing_whitespace = false
