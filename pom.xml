<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.adriandeleon</groupId>
    <artifactId>nux</artifactId>
    <version>0.5.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Nux</name>
    <description>A simple, powerful, multiplatform NUT (Network UPS Tools) client in JavaFX.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>

        <javafx.version>27.0.1</javafx.version>
        <javafx.plugin.version>0.0.8</javafx.plugin.version>
        <atlantafx.version>2.1.0</atlantafx.version>
        <dbus.version>5.2.2</dbus.version>
        <slf4j.version>2.0.20</slf4j.version>
        <junit.version>6.1.3</junit.version>

        <!-- jpackage icon format is per-OS; the os-* profiles below override this. -->
        <jpackage.icon>${project.basedir}/branding/nux.png</jpackage.icon>

        <!-- Baked into build-info.properties for the About window. The indirection is the
             standard workaround for maven.build.timestamp not being filtered directly. -->
        <maven.build.timestamp.format>yyyy-MM-dd HH:mm 'UTC'</maven.build.timestamp.format>
        <build.timestamp>${maven.build.timestamp}</build.timestamp>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>${atlantafx.version}</version>
        </dependency>

        <!-- Linux tray (StatusNotifierItem over D-Bus). Real JPMS modules; the "native
             unixsocket" transport uses the JDK's Unix-domain sockets — no JNI. -->
        <dependency>
            <groupId>com.github.hypfvieh</groupId>
            <artifactId>dbus-java-core</artifactId>
            <version>${dbus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.hypfvieh</groupId>
            <artifactId>dbus-java-transport-native-unixsocket</artifactId>
            <version>${dbus.version}</version>
        </dependency>
        <!-- dbus-java logs via slf4j; route it into java.util.logging. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Only build-info.properties is filtered: running the filter over the whole
             resource tree would corrupt the icon PNGs. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>com/nux/build-info.properties</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>com/nux/build-info.properties</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!-- Run tests on the classpath: the pure protocol tests need no JPMS ceremony,
                         and setAccessible works unrestricted from the unnamed module. -->
                    <useModulePath>false</useModulePath>
                    <systemPropertyVariables>
                        <!-- JavaFX 26's built-in headless Glass backend: no display, no Xvfb, and
                             nothing vendored (it ships inside javafx.graphics). Required for CI —
                             a dev box passes without it only because it has a display. The UI
                             tests never drive a robot, so the platform's prototype input/render
                             limits don't apply. They are tagged "fx";
                             -DexcludedGroups=fx runs the pure suite alone. -->
                        <glass.platform>Headless</glass.platform>
                        <prism.order>sw</prism.order>
                        <java.awt.headless>true</java.awt.headless>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.plugin.version}</version>
                <configuration>
                    <mainClass>com.nux/com.nux.App</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Per-OS jpackage icon format (all generated by scripts/gen_icon.java). -->
        <profile>
            <id>os-windows</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <properties>
                <jpackage.icon>${project.basedir}/branding/nux.ico</jpackage.icon>
            </properties>
        </profile>
        <profile>
            <id>os-mac</id>
            <activation>
                <os><family>mac</family></os>
            </activation>
            <properties>
                <jpackage.icon>${project.basedir}/branding/nux.icns</jpackage.icon>
            </properties>
        </profile>

        <!-- Native packaging: mvn -Pdist package
             jpackage links a runtime image from the staged modules (all deps are real JPMS
             modules — no moditect needed) and wraps it. Default output is a portable APP_IMAGE under
             target/dist/; installers via -Djpackage.type=DEB|RPM|DMG|PKG|MSI|EXE. -->
        <profile>
            <id>dist</id>
            <properties>
                <jpackage.type>APP_IMAGE</jpackage.type>
                <!-- jpackage.appVersion is DERIVED from project.version by the antrun
                     execution below (jpackage accepts only a plain dotted number).
                     It is deliberately not declared here: a hardcoded default silently
                     goes stale the first time the project version changes. Passing
                     -Djpackage.appVersion=… still wins, which is what release CI does. -->
                <jpackage.resourceDir>${project.build.directory}/jpackage-resources</jpackage.resourceDir>
            </properties>
            <build>
                <plugins>
                    <!-- Stage the jpackage resource overrides: the Linux .desktop template
                         (which adds StartupWMClass — without it the desktop can't match the
                         running window to the launcher and shows a generic icon) and the icon
                         under the name the DEB bundler regenerates. Files jpackage doesn't
                         recognise for the host platform are simply ignored. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <!-- Derive the jpackage app-version from project.version:
                                 strip any suffix (-SNAPSHOT, -rc1), and on macOS bump a
                                 leading 0. to 1. because jpackage refuses an app-version
                                 whose first number is zero (it becomes CFBundleVersion).
                                 Ant properties are immutable and Maven passes -D values
                                 in first, so an explicit -Djpackage.appVersion always wins. -->
                            <execution>
                                <id>derive-jpackage-version</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <exportAntProperties>true</exportAntProperties>
                                    <target>
                                        <loadresource property="jpackage.publicVersion">
                                            <string value="${project.version}"/>
                                            <filterchain>
                                                <tokenfilter>
                                                    <replaceregex pattern="-.*$" replace=""/>
                                                </tokenfilter>
                                            </filterchain>
                                        </loadresource>
                                        <loadresource property="jpackage.macVersion">
                                            <string value="${jpackage.publicVersion}"/>
                                            <filterchain>
                                                <tokenfilter>
                                                    <replaceregex pattern="^0\." replace="1."/>
                                                </tokenfilter>
                                            </filterchain>
                                        </loadresource>
                                        <condition property="jpackage.appVersion" value="${jpackage.macVersion}">
                                            <and>
                                                <os family="mac"/>
                                                <matches string="${jpackage.publicVersion}" pattern="^0\."/>
                                            </and>
                                        </condition>
                                        <property name="jpackage.appVersion" value="${jpackage.publicVersion}"/>
                                        <echo message="jpackage app-version: ${jpackage.appVersion}"/>
                                    </target>
                                </configuration>
                            </execution>
                            <execution>
                                <id>stage-jpackage-resources</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${jpackage.resourceDir}"/>
                                        <copy todir="${jpackage.resourceDir}">
                                            <fileset dir="${project.basedir}/packaging/linux"/>
                                        </copy>
                                        <copy file="${project.basedir}/branding/nux.png"
                                              tofile="${jpackage.resourceDir}/Nux.png"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- The module path jpackage links from: every runtime dependency as a
                         modular jar. Maven resolves JavaFX to both an empty placeholder jar
                         and the real per-OS one; the placeholders are automatic modules
                         (javafx.*Empty) that nothing requires, so jlink never resolves them. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>stage-modules</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <outputDirectory>${project.build.directory}/modules</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.6.6</version>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jpackage</goal>
                                </goals>
                                <configuration>
                                    <name>Nux</name>
                                    <appVersion>${jpackage.appVersion}</appVersion>
                                    <vendor>Adrian De Leon</vendor>
                                    <!-- Becomes Comment= in the Linux .desktop entry. -->
                                    <description>NUT (Network UPS Tools) client</description>
                                    <type>${jpackage.type}</type>
                                    <!-- jpackage runs jlink itself (rather than javafx:jlink) because
                                         that plugin can't add a module nothing `requires` or pass
                                         jlink plugin options. jdk.localedata is only ever looked up
                                         as a service, so it must be added by name: without it a
                                         packaged build formats numbers as English under a German
                                         UI while a source run (full JDK) doesn't. include-locales
                                         keeps just the bundled UI languages (each with all its
                                         regions, so de-AT/de-CH still format correctly): ~2 MB
                                         instead of ~25 MB of CLDR data. Keep the list in step with
                                         Messages.LANGUAGES. -->
                                    <module>com.nux/com.nux.App</module>
                                    <modulePaths>
                                        <modulePath>${project.build.directory}/${project.build.finalName}.jar</modulePath>
                                        <modulePath>${project.build.directory}/modules</modulePath>
                                    </modulePaths>
                                    <addModules>
                                        <addModule>jdk.localedata</addModule>
                                    </addModules>
                                    <jLinkOptions>
                                        <jLinkOption>--strip-debug</jLinkOption>
                                        <jLinkOption>--no-man-pages</jLinkOption>
                                        <jLinkOption>--no-header-files</jLinkOption>
                                        <jLinkOption>--include-locales=en,es,fr,de,pt,it</jLinkOption>
                                    </jLinkOptions>
                                    <destination>${project.build.directory}/dist</destination>
                                    <icon>${jpackage.icon}</icon>
                                    <resourceDir>${jpackage.resourceDir}</resourceDir>
                                    <!-- Windows (ignored elsewhere). Without win-menu/win-shortcut
                                         the MSI installs with no Start-menu entry at all. -->
                                    <winMenu>true</winMenu>
                                    <winMenuGroup>Nux</winMenuGroup>
                                    <winShortcut>true</winShortcut>
                                    <!-- The MSI UpgradeCode: an install with the same code replaces
                                         the old version instead of sitting beside it. NEVER CHANGE
                                         IT — a new value orphans every existing install. It is the
                                         value jpackage derives by default (name-based UUID of
                                         "UpgradeCode/<vendor>/<name>"), pinned so that renaming the
                                         vendor or app can't silently change it. -->
                                    <winUpgradeUuid>76de9bd5-010c-3a83-84fa-6223cd5b3a32</winUpgradeUuid>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
