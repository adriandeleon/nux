<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.adriandeleon</groupId>
    <artifactId>nux</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Nux</name>
    <description>A simple, powerful, multiplatform NUT (Network UPS Tools) client in JavaFX.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>

        <javafx.version>26.0.1</javafx.version>
        <javafx.plugin.version>0.0.8</javafx.plugin.version>
        <atlantafx.version>2.1.0</atlantafx.version>
        <dbus.version>5.1.1</dbus.version>
        <slf4j.version>2.0.17</slf4j.version>
        <junit.version>5.11.4</junit.version>

        <!-- jpackage icon format is per-OS; the os-* profiles below override this. -->
        <jpackage.icon>${project.basedir}/branding/nux.png</jpackage.icon>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>${atlantafx.version}</version>
        </dependency>

        <!-- Linux tray (StatusNotifierItem over D-Bus). Real JPMS modules; the "native
             unixsocket" transport uses the JDK's Unix-domain sockets — no JNI. -->
        <dependency>
            <groupId>com.github.hypfvieh</groupId>
            <artifactId>dbus-java-core</artifactId>
            <version>${dbus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.hypfvieh</groupId>
            <artifactId>dbus-java-transport-native-unixsocket</artifactId>
            <version>${dbus.version}</version>
        </dependency>
        <!-- dbus-java logs via slf4j; route it into java.util.logging. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!-- Run tests on the classpath: the pure protocol tests need no JPMS ceremony. -->
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.plugin.version}</version>
                <configuration>
                    <mainClass>com.nux/com.nux.App</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Per-OS jpackage icon format (all generated by scripts/gen_icon.java). -->
        <profile>
            <id>os-windows</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <properties>
                <jpackage.icon>${project.basedir}/branding/nux.ico</jpackage.icon>
            </properties>
        </profile>
        <profile>
            <id>os-mac</id>
            <activation>
                <os><family>mac</family></os>
            </activation>
            <properties>
                <jpackage.icon>${project.basedir}/branding/nux.icns</jpackage.icon>
            </properties>
        </profile>

        <!-- Native packaging: mvn -Pdist package
             Builds a jlink runtime image (all deps are real JPMS modules — no moditect needed)
             then wraps it with jpackage. Default output is a portable APP_IMAGE under
             target/dist/; installers via -Djpackage.type=DEB|RPM|DMG|PKG|MSI|EXE. -->
        <profile>
            <id>dist</id>
            <properties>
                <jpackage.type>APP_IMAGE</jpackage.type>
                <!-- jpackage rejects non-numeric app versions, so no -SNAPSHOT here. -->
                <jpackage.appVersion>0.1.0</jpackage.appVersion>
                <jpackage.resourceDir>${project.build.directory}/jpackage-resources</jpackage.resourceDir>
            </properties>
            <build>
                <plugins>
                    <!-- Stage the jpackage resource overrides: the Linux .desktop template
                         (which adds StartupWMClass — without it the desktop can't match the
                         running window to the launcher and shows a generic icon) and the icon
                         under the name the DEB bundler regenerates. Files jpackage doesn't
                         recognise for the host platform are simply ignored. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>stage-jpackage-resources</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${jpackage.resourceDir}"/>
                                        <copy todir="${jpackage.resourceDir}">
                                            <fileset dir="${project.basedir}/packaging/linux"/>
                                        </copy>
                                        <copy file="${project.basedir}/branding/nux.png"
                                              tofile="${jpackage.resourceDir}/Nux.png"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.openjfx</groupId>
                        <artifactId>javafx-maven-plugin</artifactId>
                        <version>${javafx.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>jlink</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jlink</goal>
                                </goals>
                                <configuration>
                                    <mainClass>com.nux/com.nux.App</mainClass>
                                    <jlinkImageName>nux-runtime</jlinkImageName>
                                    <launcher>nux</launcher>
                                    <noManPages>true</noManPages>
                                    <noHeaderFiles>true</noHeaderFiles>
                                    <stripDebug>true</stripDebug>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.6.6</version>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jpackage</goal>
                                </goals>
                                <configuration>
                                    <name>Nux</name>
                                    <appVersion>${jpackage.appVersion}</appVersion>
                                    <vendor>Adrian De Leon</vendor>
                                    <!-- Becomes Comment= in the Linux .desktop entry. -->
                                    <description>NUT (Network UPS Tools) client</description>
                                    <type>${jpackage.type}</type>
                                    <runtimeImage>${project.build.directory}/nux-runtime</runtimeImage>
                                    <module>com.nux/com.nux.App</module>
                                    <destination>${project.build.directory}/dist</destination>
                                    <icon>${jpackage.icon}</icon>
                                    <resourceDir>${jpackage.resourceDir}</resourceDir>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
